# Copy this file to "sfa.env" (same folder) and fill in your values.
# sfa.env is ignored by git, so your keys never reach the repository.
# Values already set in the environment take precedence over this file.

# NewsAPI key for deep dives on the best leads (https://newsapi.org → Account → API key)
NEWSAPI_KEY=

# SEC asks for a contact in the User-Agent of automated requests (IPO filings feed)
SFA_SEC_USER_AGENT=Your Name you@example.com

# Optional: where the FinBERT weights live (default: db/models/finbert, downloaded on first use)
# SFA_FINBERT_DIR=

# Optional: a different database file (default: db/sfa.sqlite)
# SFA_DB=
